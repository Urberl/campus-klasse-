rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApproved() {
      return userExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isTeacher() {
      return isApproved()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'];
    }

    function isAdmin() {
      return isApproved()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------
    // USERS / ACCOUNTS
    // ---------------------------------------------------------
    match /users/{uid} {
      // A user may always read their own profile.
      // Any approved user may read other profiles – this is needed so
      // students/teachers can find each other by name to start a
      // personal conversation (Campus-Forum → Nachrichten).
      allow read: if isSelf(uid) || isApproved();

      // Public registration can only create a student in pending state.
      allow create: if isSelf(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == uid;

      // Admins may manage all user fields.
      // Teachers may only manage the status of student accounts.
      // A user may edit their own non-security profile fields, but never role/status.
      allow update: if (isAdmin()
          && !(resource.data.role == 'admin'
               && request.resource.data.status != resource.data.status))
        || (
          isTeacher()
          && resource.data.role == 'student'
          && request.resource.data.role == 'student'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'approvedAt', 'approvedBy', 'updatedAt'])
        )
        || (
          isSelf(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      // Deleting accounts is an administrative action.
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // PERSONAL LEARNING DATA
    // ---------------------------------------------------------
    match /journal/{id} {
      allow read: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
    }

    match /competencies/{id} {
      allow read: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
    }

    match /lernpfade/{id} {
      allow read: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
    }

    // Resilienz-Schatzkiste: bewusst OHNE Lehrkraft-Ausnahme – ausschließlich
    // die Person selbst darf ihre eigenen gespeicherten Übungen lesen/ändern,
    // nicht einmal Lehrkräfte oder Admins.
    match /resilienzSchaetze/{id} {
      allow read, delete: if isApproved() && resource.data.uid == request.auth.uid;
      allow create: if isApproved() && request.resource.data.uid == request.auth.uid;
    }

    // Herkunftsorte-Karte (Landkreis Weilheim-Schongau): jede Person legt
    // genau einen eigenen Eintrag an (Dokument-ID = eigene UID), alle
    // freigeschalteten Nutzer:innen sehen die gesamte Karte.
    match /heimatorte/{uid} {
      allow read: if isApproved();
      allow create, update: if isApproved() && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isApproved() && uid == request.auth.uid;
    }

    // Steckbriefe fürs Kennenlernen: jede Person legt genau ein eigenes
    // Profil an (Dokument-ID = eigene UID), alle freigeschalteten
    // Nutzer:innen dürfen alle Steckbriefe lesen.
    match /steckbriefe/{uid} {
      allow read: if isApproved();
      allow create, update: if isApproved() && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isApproved() && uid == request.auth.uid;
    }

    // ---------------------------------------------------------
    // SHARED CAMPUS CONTENT
    // ---------------------------------------------------------
    match /tasks/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.ownerUid == resource.data.ownerUid);
    }

    match /projects/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /posts/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.authorUid == request.auth.uid;

      // Teachers/admins may moderate. Students may only perform the
      // specific like/comment updates used by the app.
      allow update: if isTeacher()
        || (
          isApproved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && (
            (!resource.data.keys().hasAny(['likes']) && request.resource.data.likes == 1)
            || (resource.data.keys().hasAny(['likes']) && request.resource.data.likes == resource.data.likes + 1)
          )
        )
        || (
          isApproved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
          && request.resource.data.comments.size() == resource.data.comments.size() + 1
        );

      allow delete: if isTeacher()
        || (isApproved() && resource.data.authorUid == request.auth.uid);
    }

    // ---------------------------------------------------------
    // PINNWAND (Padlet-artige Raster-Boards für Gruppenarbeit)
    // ---------------------------------------------------------
    match /boards/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      // Löschen ist bewusst nur Lehrkräften vorbehalten (auch wenn hier
      // zusätzlich die Ersteller:in erlaubt ist), damit beim Löschen
      // eines Boards zuverlässig auch alle zugehörigen boardPosts anderer
      // Autor:innen entfernt werden können (siehe boardPosts unten).
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /boardPosts/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.authorUid == request.auth.uid);
    }

    // ---------------------------------------------------------
    // WORTWOLKE (Stichworte sammeln, Häufigkeit bestimmt die Größe)
    // ---------------------------------------------------------
    match /wordclouds/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /wordcloudEntries/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if isTeacher()
        || (isApproved() && resource.data.authorUid == request.auth.uid);
    }

    // ---------------------------------------------------------
    // KANBAN-BOARD (Aufgaben in Spalten Offen / In Arbeit / Fertig)
    // ---------------------------------------------------------
    match /kanbanBoards/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /kanbanCards/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;

      // Jede/r Beteiligte darf eine Karte in eine andere Spalte
      // verschieben (nur status/updatedAt). Titel/Details/Zuständigkeit
      // darf weiterhin nur die Ersteller:in oder eine Lehrkraft ändern.
      allow update: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid)
        || (isApproved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));

      allow delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------------------------------------------------
    // TERMINFINDUNG (Terminvorschläge, Gruppe stimmt ab)
    // ---------------------------------------------------------
    match /termPolls/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // Eine Stimme ist ein Dokument mit fester ID "<pollId>_<uid>" –
    // dadurch kann jede Person ihre eigene Stimme jederzeit
    // überschreiben, aber niemals die Stimme einer anderen Person.
    match /termVotes/{id} {
      allow read: if isApproved();
      allow create, update: if isApproved()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isTeacher()
        || (isApproved() && resource.data.uid == request.auth.uid);
    }

    // ---------------------------------------------------------
    // TEAM GESUCHT (Pinnwand für Gruppenfindung)
    // ---------------------------------------------------------
    match /teamAds/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.authorUid == request.auth.uid;

      // Die Autor:in darf das Gesuch vollständig bearbeiten. Jede
      // andere freigeschaltete Person darf ausschließlich das Feld
      // "interested" ändern, um Interesse zu zeigen/zurückzuziehen.
      allow update: if isTeacher()
        || (isApproved() && resource.data.authorUid == request.auth.uid)
        || (isApproved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interested']));

      allow delete: if isTeacher()
        || (isApproved() && resource.data.authorUid == request.auth.uid);
    }

    // ---------------------------------------------------------
    // GEMEINSAME CHECKLISTE (Meilensteine gemeinsam abhaken)
    // ---------------------------------------------------------
    match /checklists/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /checklistItems/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;

      // Abhaken darf jede freigeschaltete Person (nur done/doneBy/
      // doneByName/updatedAt). Den Text ändern nur Ersteller:in
      // oder Lehrkraft.
      allow update: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid)
        || (isApproved()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['done','doneBy','doneByName','updatedAt']));

      allow delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------------------------------------------------
    // MELDEFUNKTION (Forum, Pinnwand, Team gesucht → Lehrkräfte)
    // Nur Lehrkräfte dürfen Meldungen lesen, damit weder die
    // gemeldete Person noch andere Schüler:innen sie sehen.
    // ---------------------------------------------------------
    match /reports/{id} {
      allow read: if isTeacher();
      allow create: if isApproved()
        && request.resource.data.reportedBy == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    // ---------------------------------------------------------
    // VERSTÄNDNIS-AMPEL (🟢🟡🔴 Live-Feedback)
    // ---------------------------------------------------------
    match /ampelRounds/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // Eine Antwort ist ein Dokument mit fester ID "<roundId>_<uid>" –
    // jede Person kann nur ihre eigene Antwort setzen/überschreiben.
    match /ampelResponses/{id} {
      allow read: if isApproved();
      allow create, update: if isApproved()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isTeacher()
        || (isApproved() && resource.data.uid == request.auth.uid);
    }

    // ---------------------------------------------------------
    // LIVE-UMFRAGE (Frage mit Antwortoptionen)
    // ---------------------------------------------------------
    match /polls/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // Eine Stimme ist ein Dokument mit fester ID "<pollId>_<uid>".
    match /pollVotes/{id} {
      allow read: if isApproved();
      allow create, update: if isApproved()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isTeacher()
        || (isApproved() && resource.data.uid == request.auth.uid);
    }

    // ---------------------------------------------------------
    // ZUFALLS-PICKER "WER IST DRAN?" (eigene wiederverwendbare Listen)
    // ---------------------------------------------------------
    match /randomPickerLists/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;

      // Jede freigeschaltete Person darf "losen" (nur lastPick ändern).
      // Titel/Einträge bearbeiten dürfen nur Ersteller:in oder Lehrkraft.
      allow update: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid)
        || (isApproved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPick']));

      allow delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------------------------------------------------
    // KARTEIKARTEN / VOKABELTRAINER (Decks mit Frage/Antwort-Karten)
    // ---------------------------------------------------------
    match /flashcardDecks/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /flashcards/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------------------------------------------------
    // GLOSSAR / FACHBEGRIFFE-WIKI
    // ---------------------------------------------------------
    match /glossaryEntries/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------------------------------------------------
    // FACHAUFSATZ-TRAINING (Pädagogik/Psychologie, Baustein für
    // Baustein). Übungstexte sind PRIVAT – exakt wie beim
    // Lernjournal darf nur die schreibende Person oder eine
    // Lehrkraft sie lesen, nicht andere Schüler:innen.
    // ---------------------------------------------------------
    match /essayCases/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /essayEntries/{id} {
      allow read: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());

      // Beim Anlegen dürfen Schüler:innen keine Rückmeldungs-Felder
      // vorbelegen – die kommen ausschließlich von der Lehrkraft.
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid
        && !request.resource.data.keys().hasAny(['feedback','feedbackBy','feedbackAt']);

      // Die schreibende Person darf nur ihren eigenen Text sowie das
      // Anfordern einer Rückmeldung ändern. Feedback/feedbackBy/
      // feedbackAt darf ausschließlich eine Lehrkraft setzen.
      allow update: if isTeacher()
        || (isApproved()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['text','updatedAt','feedbackRequested','feedbackRequestedAt','selfCheck','selfCheckAt']));

      allow delete: if isTeacher()
        || (isApproved() && resource.data.uid == request.auth.uid);
    }

    match /practice/{id} {
      allow read: if isApproved();
      allow create: if isTeacher()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    match /events/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isTeacher();
    }

    match /calendar/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isTeacher();
    }

    // ---------------------------------------------------------
    // CAMPUS-NEWS – getrennt vom Campus-Forum
    // ---------------------------------------------------------
    match /news/{id} {
      allow read: if isApproved();
      allow create: if isTeacher()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isTeacher()
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // PRACTICAL TRAINING / FPA
    // ---------------------------------------------------------
    match /fpaQuestions/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /fpaProjects/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------------------------------------------------
    // KI INNOVATIONSLABOR
    // ---------------------------------------------------------
    match /kiLernwerkstattLinks/{id} {
      allow read: if isApproved();
      allow create: if isTeacher()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    match /kiChallenges/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /kiSolutions/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /kiResults/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------------------------------------------------
    // LEHRKRÄFTE / KLASSENTEAM
    // ---------------------------------------------------------
    match /classTeamUpdates/{id} {
      allow read, create, update, delete: if isTeacher();
    }

    // ---------------------------------------------------------
    // LERNSTANDSMESSUNGEN
    // ---------------------------------------------------------
    match /lernstandMessungen/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isTeacher();
    }

    match /lernstandVersuche/{id} {
      // A student may only read their own attempts.
      allow read: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());

      // Students can submit only for themselves.
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid;

      // Only teachers/admins can grade/change attempts.
      allow update: if isTeacher();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // LEARNING RESOURCES
    // ---------------------------------------------------------
    match /lernressourcen/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isTeacher();
    }

    // Kompatibilität mit älteren/alternativen Ressourcen-Datensätzen.
    match /resources/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isTeacher();
    }

    // ---------------------------------------------------------
    // OPTIONAL / FUTURE CLASS STRUCTURE
    // ---------------------------------------------------------
    match /classes/{classId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // PERSÖNLICHE NACHRICHTEN (Campus-Forum → Nachrichten)
    // Schüler ↔ Schüler, Schüler ↔ Lehrkraft, Lehrkraft ↔ Lehrkraft.
    // conversationId ist immer "<kleinereUid>_<größereUid>", damit
    // beide Beteiligten dieselbe Unterhaltung eindeutig finden.
    // ---------------------------------------------------------
    match /messages/{id} {
      // Nur die zwei Beteiligten einer Nachricht dürfen sie lesen.
      allow read: if isApproved()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      // Eine Nachricht kann nur im eigenen Namen an eine andere,
      // tatsächlich existierende Person geschickt werden.
      allow create: if isApproved()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.conversationId ==
             (request.auth.uid < request.resource.data.toUid
               ? request.auth.uid + '_' + request.resource.data.toUid
               : request.resource.data.toUid + '_' + request.auth.uid);

      // Der Absender darf seine eigene Nachricht nachträglich bearbeiten
      // (nur den Text/Antwort-Bezug). Der Empfänger darf ausschließlich
      // den Lese-Status setzen (für die Benachrichtigungsanzeige).
      // Zusätzlich darf jeder Beteiligte eine Nachricht aus der EIGENEN
      // Ansicht entfernen, indem er die eigene UID zu deletedFor hinzufügt.
      // Bestehende Einträge dürfen dabei nicht entfernt werden, damit
      // niemand das Ausblenden der anderen Person rückgängig macht.
      allow update: if isApproved()
        && (
          (resource.data.fromUid == request.auth.uid
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['text', 'edited', 'updatedAt', 'replyToId', 'replyToText', 'replyToName']))
          ||
          (resource.data.toUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']))
          ||
          ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
            && request.auth.uid in request.resource.data.deletedFor
            && request.resource.data.deletedFor.hasAll(resource.data.get('deletedFor', [])))
        );

      // Jede Person darf ausschließlich ihre eigenen (gesendeten)
      // Nachrichten löschen.
      allow delete: if isApproved() && resource.data.fromUid == request.auth.uid;
    }

    // ---------------------------------------------------------
    // Deny everything not explicitly listed above.
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
