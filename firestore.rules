rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'];
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());

      // New accounts are always students. A student cannot create a teacher account.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student';

      // Students may update their own profile, but may not change their role.
      // Teachers/admins may manage profiles.
      allow update: if isTeacher()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role);

      allow delete: if isTeacher();
    }

    match /tasks/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isTeacher() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /projects/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isTeacher() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isTeacher() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /journal/{id} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isTeacher());
    }

    match /competencies/{id} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isTeacher());
    }

    match /practice/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isTeacher() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /calendar/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isTeacher() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }
  }
}
