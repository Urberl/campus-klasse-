rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApproved() {
      return userExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isTeacher() {
      return isApproved()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'];
    }

    function isAdmin() {
      return isApproved()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------
    // USERS / ACCOUNTS
    // ---------------------------------------------------------
    match /users/{uid} {
      // A user may read their own profile.
      // Approved teachers/admins may read user profiles for school administration.
      allow read: if isSelf(uid) || isTeacher();

      // Public registration can only create a student in pending state.
      allow create: if isSelf(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == uid;

      // Admins may manage all user fields.
      // Teachers may only manage the status of student accounts.
      // A user may edit their own non-security profile fields, but never role/status.
      allow update: if isAdmin()
        || (
          isTeacher()
          && resource.data.role == 'student'
          && request.resource.data.role == 'student'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'approvedAt', 'approvedBy', 'updatedAt'])
        )
        || (
          isSelf(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      // Deleting accounts is an administrative action.
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // PERSONAL LEARNING DATA
    // ---------------------------------------------------------
    match /journal/{id} {
      allow read: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
    }

    match /competencies/{id} {
      allow read: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
    }

    match /lernpfade/{id} {
      allow read: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());
    }

    // ---------------------------------------------------------
    // SHARED CAMPUS CONTENT
    // ---------------------------------------------------------
    match /tasks/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.ownerUid == resource.data.ownerUid);
    }

    match /projects/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /posts/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.authorUid == request.auth.uid;

      // Teachers/admins may moderate. Students may only perform the
      // specific like/comment updates used by the app.
      allow update: if isTeacher()
        || (
          isApproved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes == resource.data.likes + 1
        )
        || (
          isApproved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
          && request.resource.data.comments.size() == resource.data.comments.size() + 1
        );

      allow delete: if isTeacher()
        || (isApproved() && resource.data.authorUid == request.auth.uid);
    }

    match /practice/{id} {
      allow read: if isApproved();
      allow create: if isTeacher()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    match /events/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isTeacher();
    }

    match /calendar/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isTeacher();
    }

    // ---------------------------------------------------------
    // CAMPUS-NEWS – getrennt vom Campus-Forum
    // ---------------------------------------------------------
    match /news/{id} {
      allow read: if isApproved();
      allow create: if isTeacher()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isTeacher()
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // PRACTICAL TRAINING / FPA
    // ---------------------------------------------------------
    match /fpaQuestions/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /fpaProjects/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------------------------------------------------
    // KI INNOVATIONSLABOR
    // ---------------------------------------------------------
    match /kiLernwerkstattLinks/{id} {
      allow read: if isApproved();
      allow create: if isTeacher()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    match /kiChallenges/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /kiSolutions/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /kiResults/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------------------------------------------------
    // LEHRKRÄFTE / KLASSENTEAM
    // ---------------------------------------------------------
    match /classTeamUpdates/{id} {
      allow read, create, update, delete: if isTeacher();
    }

    // ---------------------------------------------------------
    // LERNSTANDSMESSUNGEN
    // ---------------------------------------------------------
    match /lernstandMessungen/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isTeacher();
    }

    match /lernstandVersuche/{id} {
      // A student may only read their own attempts.
      allow read: if isApproved()
        && (resource.data.uid == request.auth.uid || isTeacher());

      // Students can submit only for themselves.
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid;

      // Only teachers/admins can grade/change attempts.
      allow update: if isTeacher();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // LEARNING RESOURCES
    // ---------------------------------------------------------
    match /lernressourcen/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isTeacher();
    }

    // Kompatibilität mit älteren/alternativen Ressourcen-Datensätzen.
    match /resources/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isTeacher();
    }

    // ---------------------------------------------------------
    // OPTIONAL / FUTURE CLASS STRUCTURE
    // ---------------------------------------------------------
    match /classes/{classId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // Deny everything not explicitly listed above.
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
